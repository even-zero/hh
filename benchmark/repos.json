{
  "note": "Ten repositories with mixed runners. `suite` is the command a naive caller runs and SIGKILLs on a timeout; `root` is the directory hh measures (relative to the repo checkout). Pick fresh repos by re-running `python3 -m benchmark setup`.",
  "repos": [
    {
      "id": "pygments",
      "url": "https://github.com/pygments/pygments.git",
      "runner": "pytest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "-p",
        "no:cacheprovider",
        "--ignore=tests/contrast"
      ],
      "install": []
    },
    {
      "id": "docutils",
      "url": "https://github.com/docutils/docutils.git",
      "runner": "unittest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "docutils/test",
        "-t",
        "docutils",
        "-p",
        "test_*.py"
      ],
      "install": []
    },
    {
      "id": "pyyaml",
      "url": "https://github.com/yaml/pyyaml.git",
      "runner": "pytest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "install": []
    },
    {
      "id": "click",
      "url": "https://github.com/pallets/click.git",
      "runner": "pytest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "install": []
    },
    {
      "id": "jinja",
      "url": "https://github.com/pallets/jinja.git",
      "runner": "pytest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "install": [
        [
          "pip",
          "install",
          "--break-system-packages",
          "-q",
          "markupsafe",
          "trio"
        ]
      ]
    },
    {
      "id": "itsdangerous",
      "url": "https://github.com/pallets/itsdangerous.git",
      "runner": "pytest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "install": [
        [
          "pip",
          "install",
          "--break-system-packages",
          "-q",
          "freezegun"
        ]
      ]
    },
    {
      "id": "markdown",
      "url": "https://github.com/python-markdown/markdown.git",
      "runner": "unittest",
      "root": ".",
      "suite": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "install": []
    },
    {
      "id": "express",
      "url": "https://github.com/expressjs/express.git",
      "runner": "node",
      "root": ".",
      "suite": [
        "./node_modules/.bin/mocha",
        "--require",
        "test/support/env",
        "--reporter",
        "dot",
        "test/"
      ],
      "mocha_require": "test/support/env",
      "install": [
        [
          "npm",
          "install",
          "--no-audit",
          "--no-fund",
          "--loglevel=error"
        ]
      ]
    },
    {
      "id": "async",
      "url": "https://github.com/caolan/async.git",
      "runner": "node",
      "root": ".",
      "suite": [
        "npm",
        "test",
        "--silent"
      ],
      "install": [
        [
          "npm",
          "install",
          "--no-audit",
          "--no-fund",
          "--loglevel=error"
        ]
      ]
    },
    {
      "id": "supertest",
      "url": "https://github.com/ladjs/supertest.git",
      "runner": "node",
      "root": ".",
      "suite": [
        "npm",
        "test",
        "--silent"
      ],
      "install": [
        [
          "npm",
          "install",
          "--no-audit",
          "--no-fund",
          "--loglevel=error"
        ]
      ]
    }
  ]
}
